DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=replace-this-in-render
DJANGO_ALLOWED_HOSTS=abbot-study-api-staging.onrender.com
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_MEDIA_ROOT=/var/data/media
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379

CORS_ALLOWED_ORIGINS=https://abbot-study-staging.onrender.com
CSRF_TRUSTED_ORIGINS=https://abbot-study-staging.onrender.com

OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4o-mini
QUIZ_PASSING_THRESHOLD=80

DOCUMENT_PARSER_USE_RESOLVER=False
DOCUMENT_PARSER_RESOLVER_CONFIDENCE_THRESHOLD=0.70

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
DIRECT_UPLOAD_MAX_SIZE_BYTES=262144000
