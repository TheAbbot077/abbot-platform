DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=replace-with-a-unique-production-secret
DJANGO_ALLOWED_HOSTS=api.abbotstudy.com
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_MEDIA_ROOT=/var/data/media
DJANGO_LOG_LEVEL=INFO
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379

CORS_ALLOWED_ORIGINS=https://abbotstudy.com
CSRF_TRUSTED_ORIGINS=https://abbotstudy.com

OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4o-mini
QUIZ_PASSING_THRESHOLD=80

DOCUMENT_PARSER_USE_RESOLVER=False
DOCUMENT_PARSER_RESOLVER_CONFIDENCE_THRESHOLD=0.70
